<Window x:Class="Warden.DesktopWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warden ThrottleStop Widget"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Button Style for Profile Capsules -->
        <Style x:Key="ProfileBtnStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="MinWidth" Value="75"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="8"
                                Background="#1A2430"
                                BorderBrush="#2D3A4B"
                                BorderThickness="1"
                                Padding="8,5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#253344"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3E4F66"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#151E28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Button Style (Turquoise Aura) -->
        <Style x:Key="ActiveProfileBtnStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="MinWidth" Value="75"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="8"
                                BorderBrush="#00E5C9"
                                BorderThickness="1"
                                Padding="8,5"
                                SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00B8A2" Offset="0"/>
                                    <GradientStop Color="#008F7E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#00C9B1" BlurRadius="12" ShadowDepth="0" Opacity="0.55"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Widget Container -->
    <Border x:Name="mainCard"
            CornerRadius="14"
            Background="#E60D151D"
            BorderBrush="#33465C"
            BorderThickness="1.2"
            Margin="6"
            MouseDown="MainCard_MouseDown"
            MouseUp="MainCard_MouseUp">
        
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.55"/>
        </Border.Effect>

        <!-- Context Menu for Quick Actions -->
        <Border.ContextMenu>
            <ContextMenu Background="#131C26" Foreground="#F8FAFC" BorderBrush="#2A394A">
                <MenuItem x:Name="menuLock" Header="🔒 Konumu Kilitle" Click="MenuLock_Click"/>
                <Separator Background="#2A394A"/>
                <MenuItem Header="⚡ ThrottleStop'u Başlat" Click="MenuStartTS_Click"/>
                <MenuItem Header="⚙️ Warden Ayarları (Profil Seçimi)" Click="MenuOpenWarden_Click"/>
                <Separator Background="#2A394A"/>
                <MenuItem Header="❌ Widget'ı Gizle" Click="MenuHideWidget_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid Margin="10,6,10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header & Grip Bar -->
            <Grid Grid.Row="0" Margin="2,0,2,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="10" Foreground="#00C9B1" Margin="0,0,4,0"/>
                    <TextBlock Text="THROTTLESTOP" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btnLockToggle"
                            Background="Transparent" BorderThickness="0"
                            Padding="2" Cursor="Hand" ToolTip="Konumu Kilitle / Taşı"
                            Click="BtnLockToggle_Click">
                        <TextBlock x:Name="txtLockIcon" Text="🔓" FontSize="9" Foreground="#64748B"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Dynamic Profile Buttons Container -->
            <StackPanel x:Name="panelProfiles" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Profile 1: Performance -->
                <Button x:Name="btnProfile1"
                        Style="{StaticResource ProfileBtnStyle}"
                        Margin="0,0,6,0"
                        Click="BtnProfile_Click" Tag="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="11" Margin="0,0,3,0"/>
                        <TextBlock x:Name="txtProfile1" Text="Perf" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Profile 2: Game -->
                <Button x:Name="btnProfile2"
                        Style="{StaticResource ProfileBtnStyle}"
                        Margin="0,0,6,0"
                        Click="BtnProfile_Click" Tag="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎮" FontSize="11" Margin="0,0,3,0"/>
                        <TextBlock x:Name="txtProfile2" Text="Game" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Profile 3: Internet -->
                <Button x:Name="btnProfile3"
                        Style="{StaticResource ProfileBtnStyle}"
                        Margin="0,0,6,0"
                        Click="BtnProfile_Click" Tag="2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌐" FontSize="11" Margin="0,0,3,0"/>
                        <TextBlock x:Name="txtProfile3" Text="Net" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Profile 4: Battery -->
                <Button x:Name="btnProfile4"
                        Style="{StaticResource ProfileBtnStyle}"
                        Margin="0,0,0,0"
                        Click="BtnProfile_Click" Tag="3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔋" FontSize="11" Margin="0,0,3,0"/>
                        <TextBlock x:Name="txtProfile4" Text="Batt" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
