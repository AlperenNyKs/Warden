<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Warden</AssemblyName>
    <RootNamespace>Warden</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWpf>true</UseWpf>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Paketlerin onlarca dildeki uydu kaynak klasörlerini çıktıya kopyalama (uygulama yalnızca TR/EN) -->
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
    <!-- Sürüm: CI etiketten (v1.2.3) -p:Version ile ezer -->
    <Version>1.7.0</Version>
  </PropertyGroup>

  <!-- Test projesi aynı klasör ağacında: kaynakları/çıktıları ana uygulamaya derlenmesin -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <Page Remove="Tests\**" />
    <None Remove="Tests\**" />
    <None Remove="licenses\**" />
    <EmbeddedResource Remove="Tests\**" />
    <InternalsVisibleTo Include="Warden.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\icon.ico" />
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

</Project>
