<Window x:Class="Warden.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warden"
        Height="640" Width="940"
        MinHeight="580" MinWidth="840"
        Background="#0B0B0F"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Topmost="False"
        ShowInTaskbar="True">

    <!-- WindowChrome: AllowsTransparency (layered pencere, pahalı render) yerine özel başlık çubuğu.
         Sürükleme, çift tıkla büyütme ve Aero Snap Windows tarafından yapılır; büyütünce görev çubuğu kapanmaz. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ── Warden Color Palette (HUD: siyah + turuncu) ── -->
        <SolidColorBrush x:Key="BgMain"       Color="#0B0B0F"/>
        <SolidColorBrush x:Key="BgSidebar"    Color="#08080B"/>
        <SolidColorBrush x:Key="BgSurface"    Color="#101016"/>
        <SolidColorBrush x:Key="BgCard"       Color="#13131A"/>
        <SolidColorBrush x:Key="BgCardHover"  Color="#1A1A23"/>
        <SolidColorBrush x:Key="BgWidget"     Color="#16161E"/>
        <SolidColorBrush x:Key="BgInput"      Color="#0F0F14"/>
        <SolidColorBrush x:Key="BgHover"      Color="#1E1E28"/>
        
        <!-- Accents -->
        <SolidColorBrush x:Key="Accent"       Color="#FF8A3D"/>
        <SolidColorBrush x:Key="AccentDim"    Color="#1AFF8A3D"/>
        <SolidColorBrush x:Key="AccentHov"    Color="#FFA463"/>
        <SolidColorBrush x:Key="AccentPill"   Color="#26FF8A3D"/>
        <SolidColorBrush x:Key="AccentRed"    Color="#FF3B5C"/>
        <SolidColorBrush x:Key="AccentRedDim" Color="#22FF3B5C"/>
        <SolidColorBrush x:Key="AccentRedHov" Color="#FF5270"/>
        
        <!-- Typography -->
        <SolidColorBrush x:Key="TxtPrimary"   Color="#EDEDF2"/>
        <SolidColorBrush x:Key="TxtSecond"    Color="#A3A3B2"/>
        <SolidColorBrush x:Key="TxtMuted"     Color="#5C5C6B"/>
        
        <!-- Borders -->
        <SolidColorBrush x:Key="Border"       Color="#22222B"/>
        <SolidColorBrush x:Key="BorderLight"  Color="#2A2A35"/>
        <SolidColorBrush x:Key="BorderGlow"   Color="#55FF8A3D"/>
        <SolidColorBrush x:Key="Green"        Color="#FF8A3D"/>
        <SolidColorBrush x:Key="Red"          Color="#FF3B5C"/>

        <!-- ── ScrollBar Style ── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumbBorder" Background="#4A4A58" CornerRadius="3" Margin="1,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#FF8A3D"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#FF8A3D"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Base Flat Button ── -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource BgWidget}"/>
            <Setter Property="Foreground"      Value="{StaticResource TxtPrimary}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"   Value="{StaticResource BgHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush"  Value="{StaticResource BorderLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background"   Value="{StaticResource BgInput}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary Accent Button (Turquoise Glow) ── -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background"      Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="#060608"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHov}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Danger Outline Button ── -->
        <Style x:Key="OutlineRedButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentRed}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="{StaticResource AccentRed}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentRedDim}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentRedHov}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Danger Red Button (Fill) ── -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background"      Value="{StaticResource AccentRedDim}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentRed}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="{StaticResource AccentRed}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FF3B5C"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentRedHov}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Standard Windows 11 TitleBar Buttons ── -->
        <Style x:Key="Win11TitleButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="46"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#24242E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#17171F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Win11CloseButton" TargetType="Button" BasedOn="{StaticResource Win11TitleButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#9E2216"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Sidebar Capsule Button Style ── -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TxtSecond}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="60"/>
            <Setter Property="Width"           Value="76"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdCapsule" Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="4,0,4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdCapsule" Property="Background" Value="{StaticResource BgHover}"/>
                                <Setter Property="Foreground"                  Value="{StaticResource TxtPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdCapsule" Property="Background" Value="{StaticResource BgWidget}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Başlık ve büyük sayılar için gömülü yazı tipi (Chakra Petch, OFL) -->
        <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Chakra Petch, Segoe UI</FontFamily>
        <SolidColorBrush x:Key="NavActiveBg" Color="#24180F"/>

        <!-- ── Styled TextBox ── -->
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"      Value="{StaticResource TxtPrimary}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="FontFamily"      Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize"        Value="12.5"/>
            <Setter Property="CaretBrush"      Value="{StaticResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Styled ComboBox ── -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"      Value="{StaticResource TxtPrimary}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="FontFamily"      Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize"        Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton" Focusable="false"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <Path Fill="{StaticResource TxtSecond}" HorizontalAlignment="Right"
                                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  Margin="12,0,32,0" VerticalAlignment="Center"/>
                                <Popup x:Name="Popup" Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False">
                                    <Border Background="{StaticResource BgCard}"
                                            BorderBrush="{StaticResource BorderLight}"
                                            BorderThickness="1" CornerRadius="8" Margin="0,4,0,0">
                                        <ScrollViewer MaxHeight="220" Margin="4">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderLight}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TxtPrimary}"/>
            <Setter Property="Padding"    Value="10,7"/>
            <Setter Property="FontSize"   Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPill}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Toggle Switch (CheckBox) ── -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TxtPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="border" Width="40" Height="22" CornerRadius="11"
                                    Background="{StaticResource BgInput}"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="knob" Width="16" Height="16"
                                         Fill="{StaticResource TxtMuted}"
                                         HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background"   Value="{StaticResource Accent}"/>
                                <Setter TargetName="border" Property="BorderBrush"  Value="{StaticResource Accent}"/>
                                <Setter TargetName="knob"   Property="Fill"          Value="#060608"/>
                                <Setter TargetName="knob"   Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob"   Property="Margin"        Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Pulse Animation (Status LED) ── -->
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ledStatus"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.3" Duration="0:0:0.9"
                             AutoReverse="True"/>
        </Storyboard>
    </Window.Resources>

    <!-- ── Main Outer Border ── -->
    <Border x:Name="rootBorder" Background="{StaticResource BgMain}"
            BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Top TitleBar & Window Controls ── -->
            <Grid Background="Transparent">
                <!-- Left Title Branding -->
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6" Margin="0,0,10,0" ClipToBounds="True">
                        <Image Source="Assets/icon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Warden" Foreground="{StaticResource TxtPrimary}"
                               FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtVersionBadge" Text="" Foreground="{StaticResource TxtSecond}"
                               FontSize="10" VerticalAlignment="Center" Margin="6,1,0,0"/>
                    
                    <!-- Status Badge Pill -->
                    <Border Background="{StaticResource AccentPill}" CornerRadius="10"
                            Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,5,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtOnlineBadge" Text="ONLINE" Foreground="{StaticResource Accent}"
                                       FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Standard Windows 11 Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Minimize -->
                    <Button x:Name="btnMinimizeTitle" Style="{StaticResource Win11TitleButton}" Click="MinimizeButton_Click" ToolTip="Küçült">
                        <Path Stroke="{StaticResource TxtSecond}" StrokeThickness="1.2"
                              Data="M 0,5 L 10,5" Width="10" Height="10"/>
                    </Button>
                    <!-- Maximize -->
                    <Button x:Name="btnMaximizeTitle" Style="{StaticResource Win11TitleButton}" Click="MaximizeButton_Click" ToolTip="Büyüt">
                        <Path Stroke="{StaticResource TxtSecond}" StrokeThickness="1.2"
                              Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Width="10" Height="10"/>
                    </Button>
                    <!-- Close / Hide to Tray -->
                    <Button x:Name="btnCloseTitle" Style="{StaticResource Win11CloseButton}" Click="CloseButton_Click" ToolTip="Kapat (Tepside çalışır)">
                        <Path Stroke="{StaticResource TxtSecond}" StrokeThickness="1.2"
                              Data="M 0,0 L 9,9 M 0,9 L 9,0" Width="9" Height="9"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── Body: Sidebar + Main Content ── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Modern Sidebar ── -->
                <Border Background="{StaticResource BgSidebar}"
                        BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <!-- Top Nav Items -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">

                            <!-- Nav: Overview -->
                            <Grid Margin="0,2">
                                <Rectangle x:Name="rectOverviewActive" Width="3" Height="28" HorizontalAlignment="Left"
                                           Fill="{StaticResource Accent}" RadiusX="2" RadiusY="2"
                                           Visibility="Visible"/>
                                <Button x:Name="btnNavOverview" Style="{StaticResource SidebarButton}" Click="BtnNavOverview_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M3,3 H10 V12 H3 Z M14,3 H21 V8 H14 Z M14,12 H21 V21 H14 Z M3,16 H10 V21 H3 Z" StrokeThickness="1.8" StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="lblNavOverview" Text="Panel" FontSize="10" Margin="0,4,0,0"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Nav: Home -->
                            <Grid Margin="0,2">
                                <Rectangle x:Name="rectHomeActive" Width="3" Height="28" HorizontalAlignment="Left"
                                           Fill="{StaticResource Accent}" RadiusX="2" RadiusY="2"
                                           Visibility="Collapsed"/>
                                <Button x:Name="btnNavHome" Style="{StaticResource SidebarButton}" Click="BtnNavHome_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M9,18 V5 L20,3 V16 M9,18 A3,3 0 1 1 3,18 A3,3 0 1 1 9,18 M20,16 A3,3 0 1 1 14,16 A3,3 0 1 1 20,16" StrokeThickness="1.8" StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="lblNavHome" Text="Sonar" FontSize="10" Margin="0,4,0,0"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Nav: Device -->
                            <Grid Margin="0,2">
                                <Rectangle x:Name="rectDeviceActive" Width="3" Height="28" HorizontalAlignment="Left"
                                           Fill="{StaticResource Accent}" RadiusX="2" RadiusY="2"
                                           Visibility="Collapsed"/>
                                <Button x:Name="btnNavDevice" Style="{StaticResource SidebarButton}" Click="BtnNavDevice_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M4,9 V15 H8 L13,19 V5 L8,9 Z M16.5,8.5 A5,5 0 0 1 16.5,15.5" StrokeThickness="1.8" StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="lblNavDevice" Text="Ses" FontSize="10" Margin="0,4,0,0"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Nav: Gpu -->
                            <Grid Margin="0,2">
                                <Rectangle x:Name="rectGpuActive" Width="3" Height="28" HorizontalAlignment="Left"
                                           Fill="{StaticResource Accent}" RadiusX="2" RadiusY="2"
                                           Visibility="Collapsed"/>
                                <Button x:Name="btnNavGpu" Style="{StaticResource SidebarButton}" Click="BtnNavGpu_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M3,7 H21 V17 H3 Z M15,10 H18 M15,14 H18 M9,9.5 A2.5,2.5 0 1 1 9,14.5 A2.5,2.5 0 1 1 9,9.5" StrokeThickness="1.8" StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="lblNavGpu" Text="GPU" FontSize="10" Margin="0,4,0,0"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Nav: Telemetry -->
                            <Grid Margin="0,2">
                                <Rectangle x:Name="rectTelemetryActive" Width="3" Height="28" HorizontalAlignment="Left"
                                           Fill="{StaticResource Accent}" RadiusX="2" RadiusY="2"
                                           Visibility="Collapsed"/>
                                <Button x:Name="btnNavTelemetry" Style="{StaticResource SidebarButton}" Click="BtnNavTelemetry_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M3,12 H7 L10,5 L14,19 L17,12 H21" StrokeThickness="1.8" StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="lblNavTelemetry" Text="Sensörler" FontSize="10" Margin="0,4,0,0"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Nav: Status -->
                            <Grid Margin="0,2">
                                <Rectangle x:Name="rectStatusActive" Width="3" Height="28" HorizontalAlignment="Left"
                                           Fill="{StaticResource Accent}" RadiusX="2" RadiusY="2"
                                           Visibility="Collapsed"/>
                                <Button x:Name="btnNavStatus" Style="{StaticResource SidebarButton}" Click="BtnNavStatus_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M9,12 L11,14 L15,10 M12,3 A9,9 0 1 1 12,21 A9,9 0 1 1 12,3" StrokeThickness="1.8" StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="lblNavStatus" Text="Durum" FontSize="10" Margin="0,4,0,0"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Nav: Settings -->
                            <Grid Margin="0,2">
                                <Rectangle x:Name="rectSettingsActive" Width="3" Height="28" HorizontalAlignment="Left"
                                           Fill="{StaticResource Accent}" RadiusX="2" RadiusY="2"
                                           Visibility="Collapsed"/>
                                <Button x:Name="btnNavSettings" Style="{StaticResource SidebarButton}" Click="BtnNavSettings_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M12,9 A3,3 0 1 1 12,15 A3,3 0 1 1 12,9 M12,2 V5 M12,19 V22 M4.2,4.2 L6.3,6.3 M17.7,17.7 L19.8,19.8 M2,12 H5 M19,12 H22 M4.2,19.8 L6.3,17.7 M17.7,6.3 L19.8,4.2" StrokeThickness="1.8" StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="lblNavSettings" Text="Ayarlar" FontSize="10" Margin="0,4,0,0"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>

                        <!-- Bottom Status Widget -->
                        <!-- Sonar bağlantı göstergesi: yalnızca ışık + "Sonar"; ayrıntılar ipucunda, tıklayınca Sistem Durumu -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16"
                                    HorizontalAlignment="Center">
                            <Border x:Name="sonarWidget" Background="{StaticResource BgSurface}" CornerRadius="10"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    Padding="6,8" Width="68" Cursor="Hand" ToolTip=" "
                                    ToolTipOpening="SonarWidget_ToolTipOpening"
                                    MouseLeftButtonUp="SonarWidget_MouseLeftButtonUp">
                                <StackPanel>
                                    <Ellipse x:Name="ledStatus" Width="9" Height="9"
                                             Fill="{StaticResource Accent}"
                                             HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="txtSonarLabel" Text="Sonar"
                                               Foreground="{StaticResource Accent}" FontSize="9"
                                               FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <!-- İpucu için tutulan durum metinleri (görünmez) -->
                                    <TextBlock x:Name="txtConnectionStatus" Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtActivePreset" Visibility="Collapsed"/>
                                    <Ellipse x:Name="ledActive" Width="0" Height="0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ── Main Content Area ── -->
                <Border Grid.Column="1" Background="{StaticResource BgSurface}" Margin="0,0,0,0">
                    <Grid Margin="24,20,24,20">

                        <!-- ════════════════════════════════════════════════ -->
                        <!-- 1) PROFILES PAGE                                -->
                        <!-- ════════════════════════════════════════════════ -->
                        <!-- ════════════════════════════════════════════════ -->
                        <!-- OVERVIEW (PANEL) PAGE                             -->
                        <!-- ════════════════════════════════════════════════ -->
                        <ScrollViewer x:Name="pageOverview" Visibility="Visible"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,6,0">
                                <!-- Başlık + hızlı eylemler -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="lblOverviewHeader" Text="Panel" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource TxtPrimary}"/>
                                        <TextBlock x:Name="lblOverviewDesc" Text="Oyun ve sistem durumu tek ekranda"
                                                   FontSize="12" Foreground="{StaticResource TxtSecond}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="btnOvScan" Style="{StaticResource FlatButton}" Padding="16,9" Margin="0,0,8,0"
                                                Click="BtnOvScan_Click">
                                            <TextBlock x:Name="lblOvScan" Text="Oyunları tara"/>
                                        </Button>
                                        <Button x:Name="btnOvRecord" Style="{StaticResource AccentButton}" Padding="16,9"
                                                Click="BtnRecord_Click">
                                            <TextBlock x:Name="lblOvRecord" Text="● KAYIT" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Aktif oyun -->
                                <Border Background="{StaticResource BgCard}" CornerRadius="6" Padding="18,14" Margin="0,0,0,14"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="dotOvGame" Width="10" Height="10" Fill="{StaticResource TxtMuted}"
                                                 VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="txtOvGameState" Text="MASAÜSTÜ" FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TxtSecond}"/>
                                            <TextBlock FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                                <Run x:Name="runOvGame" Text="–" Foreground="{StaticResource TxtPrimary}"/>
                                                <Run x:Name="runOvPreset" Text="" Foreground="{StaticResource Accent}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="txtOvSession" Text="" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TxtPrimary}" HorizontalAlignment="Right"/>
                                            <TextBlock x:Name="lblOvSession" Text="" FontSize="11" Foreground="{StaticResource TxtSecond}"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- CPU / GPU halka göstergeleri -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource BgCard}" CornerRadius="6" Padding="20"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="124" Height="124">
                                                    <Ellipse Stroke="#22222B" StrokeThickness="10"/>
                                                    <Ellipse x:Name="ringCpu" Stroke="{StaticResource Accent}" StrokeThickness="10"
                                                             StrokeDashCap="Round" StrokeDashArray="0 1000"
                                                             RenderTransformOrigin="0.5,0.5">
                                                        <Ellipse.RenderTransform>
                                                            <RotateTransform Angle="-90"/>
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>
                                                    <TextBlock x:Name="txtOvCpuTemp" Text="–" FontFamily="{StaticResource DisplayFont}"
                                                               FontSize="30" FontWeight="Bold" Foreground="{StaticResource TxtPrimary}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="CPU" FontFamily="{StaticResource DisplayFont}" FontSize="18"
                                                               FontWeight="Bold" Foreground="{StaticResource TxtPrimary}"/>
                                                    <TextBlock x:Name="txtOvCpuName" Text="–" FontSize="11" Margin="0,2,0,8"
                                                               Foreground="{StaticResource TxtSecond}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="txtOvCpuLoad" Text="–" FontSize="12" Foreground="{StaticResource TxtSecond}" Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="txtOvCpuClock" Text="–" FontSize="12" Foreground="{StaticResource TxtSecond}" Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="txtOvCpuPower" Text="–" FontSize="12" Foreground="{StaticResource TxtSecond}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="2" Background="{StaticResource BgCard}" CornerRadius="6" Padding="20"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="124" Height="124">
                                                    <Ellipse Stroke="#22222B" StrokeThickness="10"/>
                                                    <Ellipse x:Name="ringGpu" Stroke="{StaticResource Accent}" StrokeThickness="10"
                                                             StrokeDashCap="Round" StrokeDashArray="0 1000"
                                                             RenderTransformOrigin="0.5,0.5">
                                                        <Ellipse.RenderTransform>
                                                            <RotateTransform Angle="-90"/>
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>
                                                    <TextBlock x:Name="txtOvGpuTemp" Text="–" FontFamily="{StaticResource DisplayFont}"
                                                               FontSize="30" FontWeight="Bold" Foreground="{StaticResource TxtPrimary}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="GPU" FontFamily="{StaticResource DisplayFont}" FontSize="18"
                                                               FontWeight="Bold" Foreground="{StaticResource TxtPrimary}"/>
                                                    <TextBlock x:Name="txtOvGpuName" Text="–" FontSize="11" Margin="0,2,0,8"
                                                               Foreground="{StaticResource TxtSecond}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="txtOvGpuLoad" Text="–" FontSize="12" Foreground="{StaticResource TxtSecond}" Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="txtOvGpuClock" Text="–" FontSize="12" Foreground="{StaticResource TxtSecond}" Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="txtOvGpuPower" Text="–" FontSize="12" Foreground="{StaticResource TxtSecond}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                </Grid>

                                <!-- Grafik + mini göstergeler -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource BgCard}" CornerRadius="6" Padding="16,14" Margin="0,0,0,8"
                                            BorderBrush="{StaticResource Border}" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock x:Name="lblOvGraph" Text="SON 60 SANİYE · SICAKLIK" FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TxtSecond}"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Rectangle Width="10" Height="3" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="CPU" FontSize="11" Foreground="{StaticResource TxtSecond}" Margin="0,0,12,0"/>
                                                    <Rectangle Width="10" Height="3" Fill="#38BDF8" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="GPU" FontSize="11" Foreground="{StaticResource TxtSecond}"/>
                                                </StackPanel>
                                            </Grid>
                                            <Canvas x:Name="cvsOverviewChart" Height="132" ClipToBounds="True"
                                                    SizeChanged="CvsOverviewChart_SizeChanged"/>
                                        </StackPanel>
                                    </Border>
                                    <UniformGrid Grid.Column="2" Columns="2" Rows="2" Margin="0,0,-8,0">
                                            <Border Background="{StaticResource BgCard}" CornerRadius="6" Padding="14,12" Margin="0,0,8,8"
                                                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock x:Name="lblOvTileRam" Text="Bellek" FontSize="11" Foreground="{StaticResource TxtSecond}"/>
                                                    <TextBlock x:Name="txtOvTileRam" Text="–" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                                                               FontWeight="SemiBold" Foreground="{StaticResource TxtPrimary}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BgCard}" CornerRadius="6" Padding="14,12" Margin="0,0,8,8"
                                                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock x:Name="lblOvTileHotSpot" Text="GPU Hot Spot" FontSize="11" Foreground="{StaticResource TxtSecond}"/>
                                                    <TextBlock x:Name="txtOvTileHotSpot" Text="–" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                                                               FontWeight="SemiBold" Foreground="{StaticResource TxtPrimary}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BgCard}" CornerRadius="6" Padding="14,12" Margin="0,0,8,8"
                                                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock x:Name="lblOvTileFan" Text="En hızlı fan" FontSize="11" Foreground="{StaticResource TxtSecond}"/>
                                                    <TextBlock x:Name="txtOvTileFan" Text="–" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                                                               FontWeight="SemiBold" Foreground="{StaticResource TxtPrimary}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BgCard}" CornerRadius="6" Padding="14,12" Margin="0,0,8,8"
                                                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock x:Name="lblOvTileCpuPower" Text="CPU gücü" FontSize="11" Foreground="{StaticResource TxtSecond}"/>
                                                    <TextBlock x:Name="txtOvTileCpuPower" Text="–" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                                                               FontWeight="SemiBold" Foreground="{StaticResource TxtPrimary}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                    </UniformGrid>
                                </Grid>

                                <!-- Durum çipleri -->
                                <WrapPanel>
                                        <Border Background="{StaticResource BgCard}" CornerRadius="4" Padding="12,8" Margin="0,0,8,8"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="lblOvChipSonar" Text="Sonar" FontSize="12" Foreground="{StaticResource TxtSecond}"/>
                                                <TextBlock x:Name="txtOvChipSonar" Text="–" FontSize="12" FontWeight="Bold" Margin="6,0,0,0"
                                                           FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource TxtPrimary}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource BgCard}" CornerRadius="4" Padding="12,8" Margin="0,0,8,8"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="lblOvChipAfterburner" Text="Afterburner" FontSize="12" Foreground="{StaticResource TxtSecond}"/>
                                                <TextBlock x:Name="txtOvChipAfterburner" Text="–" FontSize="12" FontWeight="Bold" Margin="6,0,0,0"
                                                           FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource TxtPrimary}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource BgCard}" CornerRadius="4" Padding="12,8" Margin="0,0,8,8"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="lblOvChipAlarm" Text="Alarm" FontSize="12" Foreground="{StaticResource TxtSecond}"/>
                                                <TextBlock x:Name="txtOvChipAlarm" Text="–" FontSize="12" FontWeight="Bold" Margin="6,0,0,0"
                                                           FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource TxtPrimary}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource BgCard}" CornerRadius="4" Padding="12,8" Margin="0,0,8,8"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="lblOvChipPawnIo" Text="PawnIO" FontSize="12" Foreground="{StaticResource TxtSecond}"/>
                                                <TextBlock x:Name="txtOvChipPawnIo" Text="–" FontSize="12" FontWeight="Bold" Margin="6,0,0,0"
                                                           FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource TxtPrimary}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource BgCard}" CornerRadius="4" Padding="12,8" Margin="0,0,8,8"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="lblOvChipRecord" Text="Kayıt" FontSize="12" Foreground="{StaticResource TxtSecond}"/>
                                                <TextBlock x:Name="txtOvChipRecord" Text="–" FontSize="12" FontWeight="Bold" Margin="6,0,0,0"
                                                           FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource TxtPrimary}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource BgCard}" CornerRadius="4" Padding="12,8" Margin="0,0,8,8"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="lblOvChipUpdate" Text="Güncelleme" FontSize="12" Foreground="{StaticResource TxtSecond}"/>
                                                <TextBlock x:Name="txtOvChipUpdate" Text="–" FontSize="12" FontWeight="Bold" Margin="6,0,0,0"
                                                           FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource TxtPrimary}"/>
                                            </StackPanel>
                                        </Border>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid x:Name="pageProfiles" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Page Header -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock x:Name="lblPageHeader" Text="Otomatik Geçiş Profilleri"
                                           Foreground="{StaticResource TxtPrimary}"
                                           FontSize="24" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"/>
                                <TextBlock x:Name="lblPageDesc" Text="Oyun ve uygulamalara göre SteelSeries Sonar profillerini otomatik değiştirir."
                                           Foreground="{StaticResource TxtSecond}"
                                           FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Default Preset Hero Card -->
                            <Border Grid.Row="1" Background="{StaticResource BgCard}"
                                    CornerRadius="10" Padding="18,14" Margin="0,0,0,14"
                                    BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Left Accent Bar -->
                                    <Border Width="3.5" Background="{StaticResource Accent}"
                                            CornerRadius="2" Margin="0,0,14,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="lblDefaultConfig" Text="Varsayılan Profil:"
                                                   Foreground="{StaticResource TxtPrimary}"
                                                   FontWeight="Bold" FontSize="13.5"/>
                                        <TextBlock x:Name="lblDefaultConfigDesc" Text="Hiçbir kural eşleşmediğinde veya masaüstündeyken kullanılır."
                                                   Foreground="{StaticResource TxtSecond}"
                                                   FontSize="11.5" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="cbDefaultPreset" Grid.Column="2"
                                              SelectionChanged="CbDefaultPreset_SelectionChanged"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Per-App Rules Container -->
                            <Border Grid.Row="2" Background="{StaticResource BgCard}"
                                    CornerRadius="10" Padding="18,14"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Rules Table Header -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="lblPerApp" Text="UYGULAMA / OYUN"
                                                   Foreground="{StaticResource TxtSecond}"
                                                   FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="lblTargetPresetHeader" Grid.Column="2" Text="HEDEF SONAR PROFİLİ"
                                                   Foreground="{StaticResource TxtSecond}"
                                                   FontSize="10" FontWeight="Bold"/>
                                    </Grid>

                                    <!-- Rules ScrollViewer -->
                                    <ScrollViewer Grid.Row="1">
                                        <StackPanel x:Name="spRules"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Bottom Action Bar -->
                            <Grid Grid.Row="3" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Scan Games Button -->
                                <Button x:Name="btnScan" Style="{StaticResource AccentButton}"
                                        Padding="18,8" Click="BtnScan_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎮" Margin="0,0,8,0" FontFamily="Segoe UI Emoji"/>
                                        <TextBlock x:Name="lblScanBtn" Text="Yüklü Oyunları Tara"/>
                                    </StackPanel>
                                </Button>

                                <!-- Reset Button -->
                                <Button x:Name="btnClearGames" Grid.Column="1"
                                        Style="{StaticResource OutlineRedButton}"
                                        Padding="14,8" Margin="8,0,0,0" Click="BtnClearGames_Click">
                                    <TextBlock x:Name="lblBtnClear" Text="Sıfırla"/>
                                </Button>


                                <!-- Manual Add -->
                                <TextBlock x:Name="lblManualAdd" Grid.Column="3" Text="Manuel Ekle:"
                                           Foreground="{StaticResource TxtSecond}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <TextBox x:Name="txtManualExe" Grid.Column="4" Width="130" Margin="0,0,6,0"/>

                                <Button x:Name="btnBrowseExe" Grid.Column="5"
                                        Style="{StaticResource FlatButton}"
                                        Padding="10,6" Content="📁" Click="BtnBrowseExe_Click"
                                        Margin="0,0,6,0"/>

                                <TextBox x:Name="txtManualName" Grid.Column="5" Width="0"
                                         Visibility="Collapsed"/>

                                <Button x:Name="btnAddManual" Grid.Column="6"
                                        Style="{StaticResource FlatButton}"
                                        Padding="14,8" Click="BtnAddManual_Click">
                                    <TextBlock x:Name="lblBtnAddManual" Text="Ekle"/>
                                </Button>
                            </Grid>
                        </Grid>

                        <!-- ════════════════════════════════════════════════ -->
                        <!-- 2) DEVICE MANAGER PAGE                          -->
                        <!-- ════════════════════════════════════════════════ -->
                        <Grid x:Name="pageDeviceManager" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock x:Name="lblDeviceManagerHeader" Text="Ses Cihazı Yöneticisi"
                                           Foreground="{StaticResource TxtPrimary}"
                                           FontSize="24" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"/>
                                <TextBlock x:Name="lblDeviceManagerDesc"
                                           Text="İşaretlenen ses cihazları arka planda otomatik olarak gizlenir / devre dışı bırakılır."
                                           Foreground="{StaticResource TxtSecond}"
                                           FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="1" Background="{StaticResource BgCard}"
                                    CornerRadius="10" Padding="16"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                                <ScrollViewer>
                                    <ItemsControl x:Name="listAudioDevices">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BgInput}"
                                                        CornerRadius="8" Margin="0,0,0,8" Padding="14,10"
                                                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding FriendlyName}"
                                                                   Foreground="{StaticResource TxtPrimary}"
                                                                   FontSize="13" VerticalAlignment="Center"/>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsDisabled}"
                                                                  VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <StackPanel Grid.Row="2" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Margin="0,14,0,0">
                                <TextBlock x:Name="lblDeviceDelay" Text="Gecikme (sn):" Foreground="{StaticResource TxtSecond}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="txtDeviceDelay" Width="60"
                                         HorizontalContentAlignment="Center"
                                         LostFocus="TxtDeviceDelay_LostFocus" Margin="0,0,16,0"/>
                                <TextBlock x:Name="txtSavedDevice" Text="Kaydedildi ✔"
                                           Foreground="{StaticResource Accent}"
                                           VerticalAlignment="Center" Margin="0,0,14,0"
                                           Visibility="Collapsed"/>
                                <Button x:Name="btnSaveDevices" Style="{StaticResource AccentButton}"
                                        Padding="20,8" Content="Uygula ve Kaydet"
                                        Click="BtnSaveDevices_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- ════════════════════════════════════════════════ -->
                        <!-- 3) GPU MONITOR PAGE                             -->
                        <!-- ════════════════════════════════════════════════ -->
                        <Grid x:Name="pageGpuMonitor" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock x:Name="lblGpuMonitorHeader" Text="GPU Monitör &amp; Otomatik Profil"
                                           Foreground="{StaticResource TxtPrimary}"
                                           FontSize="24" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"/>
                                <TextBlock x:Name="lblGpuMonitorDesc" Text="Ekran kartı frekansını izler ve belirlenen limit aşıldığında Afterburner profilini tetikler."
                                           Foreground="{StaticResource TxtSecond}"
                                           FontSize="12" Margin="0,4,0,0"/>
                                <TextBlock x:Name="txtGpuName" Text=""
                                           Foreground="{StaticResource Accent}"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Stat Cards -->
                            <Grid Grid.Row="1" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Core Clock Card -->
                                <Border Background="{StaticResource BgCard}" CornerRadius="10"
                                        Padding="18,14" Margin="0,0,8,0"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="lblGpuCoreClock" Text="ÇEKİRDEK HIZI"
                                                   Foreground="{StaticResource TxtSecond}"
                                                   FontSize="10" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock x:Name="txtGpuClock" Text="0"
                                                       Foreground="{StaticResource Accent}"
                                                       FontSize="32" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                                            <TextBlock Text=" MHz" Foreground="{StaticResource TxtSecond}"
                                                       VerticalAlignment="Bottom" Margin="4,0,0,5"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Temperature Card -->
                                <Border Grid.Column="1" Background="{StaticResource BgCard}"
                                        CornerRadius="10" Padding="18,14" Margin="4,0,4,0"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="lblGpuTemperature" Text="SICAKLIK"
                                                   Foreground="{StaticResource TxtSecond}"
                                                   FontSize="10" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock x:Name="txtGpuTemp" Text="0"
                                                       Foreground="{StaticResource TxtPrimary}"
                                                       FontSize="32" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                                            <TextBlock Text=" °C" Foreground="{StaticResource TxtSecond}"
                                                       VerticalAlignment="Bottom" Margin="4,0,0,5"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Usage Card -->
                                <Border Grid.Column="2" Background="{StaticResource BgCard}"
                                        CornerRadius="10" Padding="18,14" Margin="8,0,0,0"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="lblGpuUsage" Text="KULLANIM"
                                                   Foreground="{StaticResource TxtSecond}"
                                                   FontSize="10" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock x:Name="txtGpuUsage" Text="0"
                                                       Foreground="{StaticResource TxtPrimary}"
                                                       FontSize="32" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                                            <TextBlock Text=" %" Foreground="{StaticResource TxtSecond}"
                                                       VerticalAlignment="Bottom" Margin="4,0,0,5"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Afterburner Config Card -->
                            <Border Grid.Row="2" Background="{StaticResource BgCard}"
                                    CornerRadius="10" Padding="20"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="lblGpuSettingsHeader" Text="MSI AFTERBURNER TETİKLEYİCİ"
                                               Foreground="{StaticResource TxtSecond}"
                                               FontSize="10" FontWeight="Bold" Margin="0,0,0,16"/>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="lblGpuLimitTitle" Text="Maksimum Saat Hızı Sınırı (MHz)"
                                                       Foreground="{StaticResource TxtPrimary}"/>
                                            <TextBlock x:Name="lblGpuLimitDesc" Text="Frekans bu sınırı aşarsa hedef profil otomatik uygulanır."
                                                       Foreground="{StaticResource TxtSecond}" FontSize="11"/>
                                        </StackPanel>
                                        <TextBox x:Name="txtTargetMhz" Grid.Column="1" Text="1550"
                                                 HorizontalContentAlignment="Center"
                                                 LostFocus="GpuSetting_Changed"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="lblGpuProfileTitle" Text="Uygulanacak Profil Numarası"
                                                       Foreground="{StaticResource TxtPrimary}"/>
                                            <TextBlock x:Name="lblGpuProfileDesc" Text="MSI Afterburner profil yuvası (1-5)"
                                                       Foreground="{StaticResource TxtSecond}" FontSize="11"/>
                                        </StackPanel>
                                        <ComboBox x:Name="cbTargetProfile" Grid.Column="1"
                                                  SelectionChanged="GpuSetting_Changed">
                                            <ComboBoxItem Content="Profil 1" Tag="1"/>
                                            <ComboBoxItem Content="Profil 2" Tag="2"/>
                                            <ComboBoxItem Content="Profil 3" Tag="3"/>
                                            <ComboBoxItem Content="Profil 4" Tag="4"/>
                                            <ComboBoxItem Content="Profil 5" Tag="5"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="lblGpuCooldownTitle" Text="Bekleme Süresi (Saniye)"
                                                       Foreground="{StaticResource TxtPrimary}"/>
                                            <TextBlock x:Name="lblGpuCooldownDesc" Text="Profil yeniden uygulanmadan önceki bekleme süresi."
                                                       Foreground="{StaticResource TxtSecond}" FontSize="11"/>
                                        </StackPanel>
                                        <ComboBox x:Name="cbCooldown" Grid.Column="1"
                                                  SelectionChanged="GpuSetting_Changed">
                                            <ComboBoxItem Content="15 Saniye" Tag="15"/>
                                            <ComboBoxItem Content="30 Saniye" Tag="30"/>
                                            <ComboBoxItem Content="60 Saniye" Tag="60"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ════════════════════════════════════════════════ -->
                        <!-- 4) SETTINGS PAGE                                -->
                        <!-- ════════════════════════════════════════════════ -->
                        <!-- ════════════════════════════════════════════════ -->
                        <!-- SYSTEM STATUS PAGE                                -->
                        <!-- ════════════════════════════════════════════════ -->
                        <Grid x:Name="pageStatus" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock x:Name="lblStatusHeader" Text="Sistem Durumu"
                                           Foreground="{StaticResource TxtPrimary}"
                                           FontSize="24" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"/>
                                <TextBlock x:Name="lblStatusDesc"
                                           Text="Warden'ın ihtiyaç duyduğu programlar ve sürücüler. Eksik olan özellikler çalışmaz."
                                           Foreground="{StaticResource TxtSecond}" TextWrapping="Wrap"
                                           FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="1" Background="{StaticResource BgCard}"
                                    CornerRadius="10" Padding="20"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="spStatusChecks"/>
                                </ScrollViewer>
                            </Border>

                            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,14,0,0">
                                <Button x:Name="btnRecheckStatus" Style="{StaticResource AccentButton}"
                                        Padding="22,9" Click="BtnRecheckStatus_Click">
                                    <TextBlock x:Name="lblRecheckStatus" Text="Yeniden kontrol et"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="pageSettings" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock x:Name="lblSettingsHeader" Text="Ayarlar"
                                           Foreground="{StaticResource TxtPrimary}"
                                           FontSize="24" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"/>
                                <TextBlock x:Name="lblSettingsDesc" Text="Uygulama davranışını ve tercihlerini yapılandırın."
                                           Foreground="{StaticResource TxtSecond}"
                                           FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="1" Background="{StaticResource BgCard}"
                                    CornerRadius="10" Padding="20"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock x:Name="lblGeneralSection" Text="GENEL AYARLAR"
                                               Foreground="{StaticResource TxtSecond}"
                                               FontSize="10" FontWeight="Bold" Margin="0,0,0,18"/>

                                                                        <!-- Start with Windows -->
                                    <Border Background="{StaticResource BgInput}" CornerRadius="8"
                                            Padding="14,12" Margin="0,0,0,10" BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="lblStartWithWin" Text="Windows ile Başlat"
                                                           Foreground="{StaticResource TxtPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="lblStartWithWinDesc"
                                                           Text="Bilgisayar açıldığında arka planda sessizce başlar."
                                                           Foreground="{StaticResource TxtSecond}" FontSize="11"/>
                                            </StackPanel>
                                            <CheckBox x:Name="chkStartup" Grid.Column="1"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Language -->
                                    <Border Background="{StaticResource BgInput}" CornerRadius="8"
                                            Padding="14,12" Margin="0,0,0,10" BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="lblLanguage" Text="Dil / Language"
                                                       Foreground="{StaticResource TxtPrimary}"
                                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="cbLanguage" Grid.Column="1"
                                                      SelectionChanged="CbLanguage_SelectionChanged">
                                                <ComboBoxItem Content="Türkçe" Tag="TR"/>
                                                <ComboBoxItem Content="English" Tag="EN"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <!-- Scan Interval -->
                                    <Border Background="{StaticResource BgInput}" CornerRadius="8"
                                            Padding="14,12" BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="lblScanInterval" Text="Tarama Aralığı (ms)"
                                                           Foreground="{StaticResource TxtPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="lblScanIntervalDesc"
                                                           Text="Aktif pencereyi kontrol etme frekansı"
                                                           Foreground="{StaticResource TxtSecond}" FontSize="11"/>
                                            </StackPanel>
                                            <TextBox x:Name="txtInterval" Grid.Column="1"
                                                     HorizontalContentAlignment="Center"
                                                     LostFocus="TxtInterval_LostFocus"/>
                                        </Grid>
                                    </Border>

                                    <!-- ── Oyun taraması ── -->
                                    <TextBlock x:Name="lblGamesSection" Text="OYUNLAR"
                                               Foreground="{StaticResource TxtSecond}"
                                               FontSize="10" FontWeight="Bold" Margin="0,22,0,12"/>

                                    <Border Background="{StaticResource BgInput}" CornerRadius="8"
                                            Padding="14,12" Margin="0,0,0,10" BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="lblAutoScan" Text="Açılışta yüklü oyunları tara"
                                                           Foreground="{StaticResource TxtPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="lblAutoScanDesc"
                                                           Text="Yeni ve kaldırılan oyunları bulur, değişiklik varsa bildirim gösterir."
                                                           Foreground="{StaticResource TxtSecond}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="chkAutoScan" Grid.Column="1"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource BgInput}" CornerRadius="8"
                                            Padding="14,12" Margin="0" BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="lblAutoAssign" Text="GG oyun profillerini otomatik ata"
                                                           Foreground="{StaticResource TxtPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="lblAutoAssignDesc"
                                                           Text="SteelSeries GG'de oyuna özel profili olan oyunlara o profili atar. Var olan kurallara dokunmaz."
                                                           Foreground="{StaticResource TxtSecond}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="chkAutoAssign" Grid.Column="1"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- ── Güncellemeler ── -->
                                    <TextBlock x:Name="lblUpdatesSection" Text="GÜNCELLEMELER"
                                               Foreground="{StaticResource TxtSecond}"
                                               FontSize="10" FontWeight="Bold" Margin="0,22,0,12"/>

                                    <Border Background="{StaticResource BgInput}" CornerRadius="8"
                                            Padding="14,12" Margin="0,0,0,10" BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="lblUpdateAutoCheck" Text="Güncellemeleri otomatik kontrol et"
                                                           Foreground="{StaticResource TxtPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="lblUpdateAutoCheckDesc"
                                                           Text="Açılışta ve 6 saatte bir GitHub'daki sürümlere bakar."
                                                           Foreground="{StaticResource TxtSecond}" FontSize="11"/>
                                            </StackPanel>
                                            <CheckBox x:Name="chkAutoUpdate" Grid.Column="1"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource BgInput}" CornerRadius="8"
                                            Padding="14,12" BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="txtCurrentVersion" Text="Yüklü sürüm"
                                                           Foreground="{StaticResource TxtPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="txtUpdateStatus" Text=""
                                                           Foreground="{StaticResource TxtSecond}" FontSize="11"
                                                           TextWrapping="Wrap" Margin="0,2,12,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="btnInstallUpdate" Style="{StaticResource AccentButton}"
                                                        Padding="14,7" Margin="0,0,8,0" Visibility="Collapsed"
                                                        Click="BtnInstallUpdate_Click">
                                                    <TextBlock x:Name="lblInstallUpdate" Text="Kur"/>
                                                </Button>
                                                <Button x:Name="btnCheckUpdates" Style="{StaticResource FlatButton}"
                                                        Padding="14,7" Click="BtnCheckUpdates_Click">
                                                    <TextBlock x:Name="lblCheckUpdates" Text="Şimdi kontrol et"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- ── Sıcaklık alarmı ── -->
                                    <TextBlock x:Name="lblTempAlarmSection" Text="SICAKLIK ALARMI"
                                               Foreground="{StaticResource TxtSecond}"
                                               FontSize="10" FontWeight="Bold" Margin="0,22,0,12"/>

                                    <Border Background="{StaticResource BgInput}" CornerRadius="8"
                                            Padding="14,12" Margin="0,0,0,10" BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="lblTempAlarm" Text="Sıcaklık alarmı"
                                                           Foreground="{StaticResource TxtPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="lblTempAlarmDesc"
                                                           Text="Sıcaklık 10 saniye boyunca sınırın üstünde kalırsa bildirim gönderir."
                                                           Foreground="{StaticResource TxtSecond}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="chkTempAlarm" Grid.Column="1"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource BgInput}" CornerRadius="8"
                                            Padding="14,12" Margin="0,0,0,10" BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="lblCpuTempLimit" Text="CPU sınırı (°C)"
                                                       Foreground="{StaticResource TxtPrimary}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBox x:Name="txtCpuTempLimit" Grid.Column="1"
                                                     HorizontalContentAlignment="Center"
                                                     LostFocus="TxtTempLimit_LostFocus"/>
                                            <TextBlock x:Name="lblGpuTempLimit" Grid.Column="3" Text="GPU sınırı (°C)"
                                                       Foreground="{StaticResource TxtPrimary}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBox x:Name="txtGpuTempLimit" Grid.Column="4"
                                                     HorizontalContentAlignment="Center"
                                                     LostFocus="TxtTempLimit_LostFocus"/>
                                        </Grid>
                                    </Border>

                                </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,14,0,0">
                                <Button x:Name="btnSaveSettings" Style="{StaticResource AccentButton}"
                                        Padding="22,9" Click="BtnSaveSettings_Click">
                                    <TextBlock x:Name="lblSaveBtn" Text="Ayarları Kaydet"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- ════════════════════════════════════════════════ -->
                        <!-- 5) TELEMETRY & HARDWARE MONITOR PAGE              -->
                        <!-- ════════════════════════════════════════════════ -->
                        <Grid x:Name="pageTelemetry" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,10,20">
                                    <!-- Page Header -->
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock x:Name="lblTelemetryHeader" Text="Sistem Telemetrisi"
                                                   Foreground="{StaticResource TxtPrimary}"
                                                   FontSize="24" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"/>
                                        <TextBlock x:Name="lblTelemetryDesc"
                                                   Text="Canlı sıcaklıklar, saat hızları, güç tüketimleri ve kullanım oranları."
                                                   Foreground="{StaticResource TxtSecond}"
                                                   FontSize="12" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- 0. PawnIO uyarısı: LibreHardwareMonitor 0.9.6+ CPU/MSR sensörleri için PawnIO sürücüsü ister -->
                                    <Border x:Name="pnlPawnIoHint" Background="{StaticResource AccentRedDim}"
                                            CornerRadius="10" Padding="16,12" Margin="0,0,0,14"
                                            BorderBrush="{StaticResource AccentRed}" BorderThickness="1"
                                            Visibility="Collapsed">
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TxtPrimary}">
                                            <Run x:Name="runPawnIoHint" Text="PawnIO sürücüsü kurulu değil."/>
                                            <Hyperlink x:Name="lnkPawnIo" NavigateUri="https://pawnio.eu/"
                                                       RequestNavigate="LnkPawnIo_RequestNavigate"
                                                       Foreground="{StaticResource Accent}">pawnio.eu</Hyperlink>
                                        </TextBlock>
                                    </Border>

                                    <!-- Oturum kaydı (CSV) -->
                                    <Border Background="{StaticResource BgCard}"
                                            CornerRadius="10" Padding="16,12" Margin="0,0,0,14"
                                            BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="dotRecording" Width="8" Height="8"
                                                             Fill="{StaticResource TxtMuted}" Margin="0,0,8,0"
                                                             VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="txtRecordingStatus" Text="Kayıt yok"
                                                               Foreground="{StaticResource TxtPrimary}"
                                                               FontWeight="SemiBold" FontSize="12"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <CheckBox x:Name="chkAutoRecord" Margin="0,8,0,0"
                                                          Checked="ChkAutoRecord_Changed" Unchecked="ChkAutoRecord_Changed">
                                                    <TextBlock x:Name="lblAutoRecord" Text="Kurallı bir oyun açılınca otomatik kaydet"
                                                               Foreground="{StaticResource TxtSecond}" FontSize="11"
                                                               TextWrapping="Wrap"/>
                                                </CheckBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="btnRecord" Style="{StaticResource AccentButton}"
                                                        Padding="14,7" Margin="0,0,8,0" Click="BtnRecord_Click">
                                                    <TextBlock x:Name="lblRecordBtn" Text="⏺ Kaydı başlat"/>
                                                </Button>
                                                <Button x:Name="btnOpenSessions" Style="{StaticResource FlatButton}"
                                                        Padding="14,7" Click="BtnOpenSessions_Click">
                                                    <TextBlock x:Name="lblOpenSessions" Text="📁 Kayıtlar"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 1. ⭐ FAVORİLER (Pinned Quick Cards) -->
                                    <Border x:Name="pnlFavoritesContainer" Background="{StaticResource BgCard}"
                                            CornerRadius="10" Padding="16,14" Margin="0,0,0,14"
                                            BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="⭐" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="lblFavoritesTitle" Text="FAVORİLER / HIZLI BAKIŞ"
                                                           Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <WrapPanel x:Name="wpFavorites"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. 📈 CANLI GRAFİK (Son 60 Saniye) -->
                                    <Border Background="{StaticResource BgCard}"
                                            CornerRadius="10" Padding="16,14" Margin="0,0,0,14"
                                            BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                        <StackPanel>
                                            <!-- Graph Header / Legend -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="lblLiveGraphTitle" Text="CANLI SENSÖR GRAFİĞİ (SON 60 SANİYE)"
                                                           Foreground="{StaticResource TxtSecond}"
                                                           FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                
                                                <WrapPanel x:Name="wpGraphLegend" Grid.Column="1" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Hint if no graph items -->
                                            <TextBlock x:Name="txtNoGraphHint"
                                                       Text="Grafikte çizilmesini istediğiniz değerlerin yanındaki 📈 butonuna tıklayın."
                                                       Foreground="{StaticResource TxtMuted}" FontSize="11" Margin="0,0,0,8"
                                                       HorizontalAlignment="Center" Visibility="Collapsed"/>

                                            <!-- Graph Canvas Area -->
                                            <Border Background="#07070A" CornerRadius="8" BorderBrush="{StaticResource Border}"
                                                    BorderThickness="1" Height="150" ClipToBounds="True">
                                                <Grid>
                                                    <Canvas x:Name="cvsChartGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                                    <Canvas x:Name="cvsChart" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                            SizeChanged="CvsChart_SizeChanged"/>
                                                </Grid>
                                            </Border>

                                            <!-- Time Axis Labels -->
                                            <Grid Margin="4,6,4,0">
                                                <TextBlock Text="-60s" Foreground="{StaticResource TxtMuted}" FontSize="9" HorizontalAlignment="Left"/>
                                                <TextBlock Text="-45s" Foreground="{StaticResource TxtMuted}" FontSize="9" HorizontalAlignment="Left" Margin="100,0,0,0"/>
                                                <TextBlock Text="-30s" Foreground="{StaticResource TxtMuted}" FontSize="9" HorizontalAlignment="Center"/>
                                                <TextBlock Text="-15s" Foreground="{StaticResource TxtMuted}" FontSize="9" HorizontalAlignment="Right" Margin="0,0,100,0"/>
                                                <TextBlock x:Name="lblGraphNow" Text="Şimdi" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. ALT KATEGORİLER (CPU, GPU, FANLAR, ANAKART, BELLEK) -->
                                    <StackPanel x:Name="pnlCategoriesContainer"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
