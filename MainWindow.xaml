<Window x:Class="Warden.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warden"
        Height="640" Width="940"
        MinHeight="580" MinWidth="840"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Topmost="False"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- ── Warden Color Palette (Turquoise Dark Dashboard) ── -->
        <SolidColorBrush x:Key="BgMain"       Color="#080C0E"/>
        <SolidColorBrush x:Key="BgSidebar"    Color="#06090A"/>
        <SolidColorBrush x:Key="BgSurface"    Color="#0C1416"/>
        <SolidColorBrush x:Key="BgCard"       Color="#101B1E"/>
        <SolidColorBrush x:Key="BgCardHover"  Color="#142327"/>
        <SolidColorBrush x:Key="BgWidget"     Color="#121F22"/>
        <SolidColorBrush x:Key="BgInput"      Color="#0A1214"/>
        <SolidColorBrush x:Key="BgHover"      Color="#182A2E"/>
        
        <!-- Accents -->
        <SolidColorBrush x:Key="Accent"       Color="#00C9B1"/>
        <SolidColorBrush x:Key="AccentDim"    Color="#1A00C9B1"/>
        <SolidColorBrush x:Key="AccentHov"    Color="#00E5CB"/>
        <SolidColorBrush x:Key="AccentPill"   Color="#2000C9B1"/>
        <SolidColorBrush x:Key="AccentRed"    Color="#FF3B5C"/>
        <SolidColorBrush x:Key="AccentRedDim" Color="#22FF3B5C"/>
        <SolidColorBrush x:Key="AccentRedHov" Color="#FF5270"/>
        
        <!-- Typography -->
        <SolidColorBrush x:Key="TxtPrimary"   Color="#F0FAFA"/>
        <SolidColorBrush x:Key="TxtSecond"    Color="#7A9A9A"/>
        <SolidColorBrush x:Key="TxtMuted"     Color="#3D5656"/>
        
        <!-- Borders -->
        <SolidColorBrush x:Key="Border"       Color="#192A2D"/>
        <SolidColorBrush x:Key="BorderLight"  Color="#22383C"/>
        <SolidColorBrush x:Key="BorderGlow"   Color="#00C9B155"/>
        <SolidColorBrush x:Key="Green"        Color="#00C9B1"/>
        <SolidColorBrush x:Key="Red"          Color="#FF3B5C"/>

        <!-- ── ScrollBar Style ── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#1C3034" CornerRadius="3" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Base Flat Button ── -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource BgWidget}"/>
            <Setter Property="Foreground"      Value="{StaticResource TxtPrimary}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"   Value="{StaticResource BgHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush"  Value="{StaticResource BorderLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background"   Value="{StaticResource BgInput}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary Accent Button (Turquoise Glow) ── -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background"      Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="#050808"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHov}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Danger Outline Button ── -->
        <Style x:Key="OutlineRedButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentRed}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="{StaticResource AccentRed}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentRedDim}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentRedHov}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Danger Red Button (Fill) ── -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background"      Value="{StaticResource AccentRedDim}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentRed}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="{StaticResource AccentRed}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FF3B5C"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentRedHov}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Standard Windows 11 TitleBar Buttons ── -->
        <Style x:Key="Win11TitleButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="46"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2C30"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#142224"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Win11CloseButton" TargetType="Button" BasedOn="{StaticResource Win11TitleButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#9E2216"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Sidebar Capsule Button Style ── -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TxtSecond}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="50"/>
            <Setter Property="Width"           Value="72"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="Segoe UI Emoji"/>
            <Setter Property="FontSize"        Value="20"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Left Active Bar -->
                            <Rectangle x:Name="activeIndicator" Width="3" HorizontalAlignment="Left"
                                       Fill="{StaticResource Accent}" RadiusX="2" RadiusY="2"
                                       Visibility="Collapsed"/>
                            <!-- Center Capsule -->
                            <Border x:Name="bdCapsule" Background="{TemplateBinding Background}"
                                    CornerRadius="10" Margin="10,3,10,3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdCapsule" Property="Background" Value="{StaticResource BgHover}"/>
                                <Setter Property="Foreground"                  Value="{StaticResource TxtPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdCapsule" Property="Background" Value="{StaticResource BgWidget}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Styled TextBox ── -->
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"      Value="{StaticResource TxtPrimary}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="FontFamily"      Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize"        Value="12.5"/>
            <Setter Property="CaretBrush"      Value="{StaticResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Styled ComboBox ── -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"      Value="{StaticResource TxtPrimary}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="FontFamily"      Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize"        Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton" Focusable="false"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <Path Fill="{StaticResource TxtSecond}" HorizontalAlignment="Right"
                                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  Margin="12,0,32,0" VerticalAlignment="Center"/>
                                <Popup x:Name="Popup" Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False">
                                    <Border Background="{StaticResource BgCard}"
                                            BorderBrush="{StaticResource BorderLight}"
                                            BorderThickness="1" CornerRadius="8" Margin="0,4,0,0">
                                        <ScrollViewer MaxHeight="220" Margin="4">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderLight}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TxtPrimary}"/>
            <Setter Property="Padding"    Value="10,7"/>
            <Setter Property="FontSize"   Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPill}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Toggle Switch (CheckBox) ── -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TxtPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="border" Width="40" Height="22" CornerRadius="11"
                                    Background="{StaticResource BgInput}"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="knob" Width="16" Height="16"
                                         Fill="{StaticResource TxtMuted}"
                                         HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background"   Value="{StaticResource Accent}"/>
                                <Setter TargetName="border" Property="BorderBrush"  Value="{StaticResource Accent}"/>
                                <Setter TargetName="knob"   Property="Fill"          Value="#050808"/>
                                <Setter TargetName="knob"   Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob"   Property="Margin"        Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Pulse Animation (Status LED) ── -->
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ledStatus"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.3" Duration="0:0:0.9"
                             AutoReverse="True"/>
        </Storyboard>
    </Window.Resources>

    <!-- ── Main Outer Border ── -->
    <Border Background="{StaticResource BgMain}" CornerRadius="12"
            BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Top TitleBar & Window Controls ── -->
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <!-- Left Title Branding -->
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6" Margin="0,0,10,0" ClipToBounds="True">
                        <Image Source="Assets/icon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Warden" Foreground="{StaticResource TxtPrimary}"
                               FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    
                    <!-- Status Badge Pill -->
                    <Border Background="{StaticResource AccentPill}" CornerRadius="10"
                            Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,5,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtOnlineBadge" Text="ONLINE" Foreground="{StaticResource Accent}"
                                       FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Standard Windows 11 Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Minimize -->
                    <Button x:Name="btnMinimizeTitle" Style="{StaticResource Win11TitleButton}" Click="MinimizeButton_Click" ToolTip="Küçült">
                        <Path Stroke="{StaticResource TxtSecond}" StrokeThickness="1.2"
                              Data="M 0,5 L 10,5" Width="10" Height="10"/>
                    </Button>
                    <!-- Maximize -->
                    <Button x:Name="btnMaximizeTitle" Style="{StaticResource Win11TitleButton}" Click="MaximizeButton_Click" ToolTip="Büyüt">
                        <Path Stroke="{StaticResource TxtSecond}" StrokeThickness="1.2"
                              Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Width="10" Height="10"/>
                    </Button>
                    <!-- Close / Hide to Tray -->
                    <Button x:Name="btnCloseTitle" Style="{StaticResource Win11CloseButton}" Click="CloseButton_Click" ToolTip="Kapat (Tepside çalışır)">
                        <Path Stroke="{StaticResource TxtSecond}" StrokeThickness="1.2"
                              Data="M 0,0 L 9,9 M 0,9 L 9,0" Width="9" Height="9"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── Body: Sidebar + Main Content ── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Modern Sidebar ── -->
                <Border Background="{StaticResource BgSidebar}"
                        BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <!-- Top Nav Items -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">

                            <!-- Nav: Profiles -->
                            <Grid Height="50" Margin="0,2">
                                <Rectangle x:Name="rectHomeActive" Width="3" HorizontalAlignment="Left"
                                           Fill="{StaticResource Accent}" RadiusX="2" RadiusY="2"/>
                                <Button x:Name="btnNavHome" Style="{StaticResource SidebarButton}"
                                        Click="BtnNavHome_Click"
                                        Foreground="{StaticResource Accent}"
                                        ToolTip="Sonar Profilleri">
                                    <TextBlock Text="🎵" FontFamily="Segoe UI Emoji" FontSize="19"/>
                                </Button>
                            </Grid>

                            <!-- Nav: Device Manager -->
                            <Grid Height="50" Margin="0,2">
                                <Rectangle x:Name="rectDeviceActive" Width="3" HorizontalAlignment="Left"
                                           Fill="{StaticResource Accent}" RadiusX="2" RadiusY="2"
                                           Visibility="Collapsed"/>
                                <Button x:Name="btnNavDevice" Style="{StaticResource SidebarButton}"
                                        Click="BtnNavDevice_Click" ToolTip="Ses Cihazı Yöneticisi">
                                    <TextBlock Text="🔊" FontFamily="Segoe UI Emoji" FontSize="19"/>
                                </Button>
                            </Grid>

                            <!-- Nav: GPU Monitor -->
                            <Grid Height="50" Margin="0,2">
                                <Rectangle x:Name="rectGpuActive" Width="3" HorizontalAlignment="Left"
                                           Fill="{StaticResource Accent}" RadiusX="2" RadiusY="2"
                                           Visibility="Collapsed"/>
                                <Button x:Name="btnNavGpu" Style="{StaticResource SidebarButton}"
                                        Click="BtnNavGpu_Click" ToolTip="GPU Performans">
                                    <TextBlock Text="⚡" FontFamily="Segoe UI Emoji" FontSize="19"/>
                                </Button>
                            </Grid>

                            <!-- Nav: Telemetry Monitor -->
                            <Grid Height="50" Margin="0,2">
                                <Rectangle x:Name="rectTelemetryActive" Width="3" HorizontalAlignment="Left"
                                           Fill="{StaticResource Accent}" RadiusX="2" RadiusY="2"
                                           Visibility="Collapsed"/>
                                <Button x:Name="btnNavTelemetry" Style="{StaticResource SidebarButton}"
                                        Click="BtnNavTelemetry_Click" ToolTip="Donanım Monitörü">
                                    <TextBlock Text="📊" FontFamily="Segoe UI Emoji" FontSize="19"/>
                                </Button>
                            </Grid>

                            <!-- Nav: Settings -->
                            <Grid Height="50" Margin="0,2">
                                <Rectangle x:Name="rectSettingsActive" Width="3" HorizontalAlignment="Left"
                                           Fill="{StaticResource Accent}" RadiusX="2" RadiusY="2"
                                           Visibility="Collapsed"/>
                                <Button x:Name="btnNavSettings" Style="{StaticResource SidebarButton}"
                                        Click="BtnNavSettings_Click" ToolTip="Ayarlar">
                                    <TextBlock Text="⚙" FontFamily="Segoe UI Emoji" FontSize="19"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Bottom Status Widget -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16"
                                    HorizontalAlignment="Center">
                            <Border Background="{StaticResource BgSurface}" CornerRadius="10"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    Padding="6,8" Width="56">
                                <StackPanel>
                                    <Ellipse x:Name="ledStatus" Width="9" Height="9"
                                             Fill="{StaticResource Accent}"
                                             HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="txtConnectionStatus" Text="● Bağlı"
                                               Foreground="{StaticResource Accent}" FontSize="9"
                                               FontWeight="Bold" HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="txtActivePreset" Text="Desktop"
                                               Foreground="{StaticResource TxtSecond}" FontSize="8"
                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0"/>
                                    <Ellipse x:Name="ledActive" Width="0" Height="0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ── Main Content Area ── -->
                <Border Grid.Column="1" Background="{StaticResource BgSurface}" Margin="0,0,0,0">
                    <Grid Margin="24,20,24,20">

                        <!-- ════════════════════════════════════════════════ -->
                        <!-- 1) PROFILES PAGE                                -->
                        <!-- ════════════════════════════════════════════════ -->
                        <Grid x:Name="pageProfiles" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Page Header -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock x:Name="lblPageHeader" Text="Otomatik Geçiş Profilleri"
                                           Foreground="{StaticResource TxtPrimary}"
                                           FontSize="22" FontWeight="Bold"/>
                                <TextBlock x:Name="lblPageDesc" Text="Oyun ve uygulamalara göre SteelSeries Sonar profillerini otomatik değiştirir."
                                           Foreground="{StaticResource TxtSecond}"
                                           FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Default Preset Hero Card -->
                            <Border Grid.Row="1" Background="{StaticResource BgCard}"
                                    CornerRadius="10" Padding="18,14" Margin="0,0,0,14"
                                    BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Left Accent Bar -->
                                    <Border Width="3.5" Background="{StaticResource Accent}"
                                            CornerRadius="2" Margin="0,0,14,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="lblDefaultConfig" Text="Varsayılan Profil:"
                                                   Foreground="{StaticResource TxtPrimary}"
                                                   FontWeight="Bold" FontSize="13.5"/>
                                        <TextBlock x:Name="lblDefaultConfigDesc" Text="Hiçbir kural eşleşmediğinde veya masaüstündeyken kullanılır."
                                                   Foreground="{StaticResource TxtSecond}"
                                                   FontSize="11.5" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="cbDefaultPreset" Grid.Column="2"
                                              SelectionChanged="CbDefaultPreset_SelectionChanged"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Per-App Rules Container -->
                            <Border Grid.Row="2" Background="{StaticResource BgCard}"
                                    CornerRadius="10" Padding="18,14"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Rules Table Header -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="lblPerApp" Text="UYGULAMA / OYUN"
                                                   Foreground="{StaticResource TxtSecond}"
                                                   FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="lblTargetPresetHeader" Grid.Column="2" Text="HEDEF SONAR PROFİLİ"
                                                   Foreground="{StaticResource TxtSecond}"
                                                   FontSize="10" FontWeight="Bold"/>
                                    </Grid>

                                    <!-- Rules ScrollViewer -->
                                    <ScrollViewer Grid.Row="1">
                                        <StackPanel x:Name="spRules"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Bottom Action Bar -->
                            <Grid Grid.Row="3" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Scan Games Button -->
                                <Button x:Name="btnScan" Style="{StaticResource AccentButton}"
                                        Padding="18,8" Click="BtnScan_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎮" Margin="0,0,8,0" FontFamily="Segoe UI Emoji"/>
                                        <TextBlock x:Name="lblScanBtn" Text="Yüklü Oyunları Tara"/>
                                    </StackPanel>
                                </Button>

                                <!-- Reset Button -->
                                <Button x:Name="btnClearGames" Grid.Column="1"
                                        Style="{StaticResource OutlineRedButton}"
                                        Padding="14,8" Margin="8,0,0,0" Click="BtnClearGames_Click">
                                    <TextBlock x:Name="lblBtnClear" Text="Sıfırla"/>
                                </Button>


                                <!-- Manual Add -->
                                <TextBlock x:Name="lblManualAdd" Grid.Column="3" Text="Manuel Ekle:"
                                           Foreground="{StaticResource TxtSecond}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <TextBox x:Name="txtManualExe" Grid.Column="4" Width="130" Margin="0,0,6,0"/>

                                <Button x:Name="btnBrowseExe" Grid.Column="5"
                                        Style="{StaticResource FlatButton}"
                                        Padding="10,6" Content="📁" Click="BtnBrowseExe_Click"
                                        Margin="0,0,6,0"/>

                                <TextBox x:Name="txtManualName" Grid.Column="5" Width="0"
                                         Visibility="Collapsed"/>

                                <Button x:Name="btnAddManual" Grid.Column="6"
                                        Style="{StaticResource FlatButton}"
                                        Padding="14,8" Click="BtnAddManual_Click">
                                    <TextBlock x:Name="lblBtnAddManual" Text="Ekle"/>
                                </Button>
                            </Grid>
                        </Grid>

                        <!-- ════════════════════════════════════════════════ -->
                        <!-- 2) DEVICE MANAGER PAGE                          -->
                        <!-- ════════════════════════════════════════════════ -->
                        <Grid x:Name="pageDeviceManager" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock x:Name="lblDeviceManagerHeader" Text="Ses Cihazı Yöneticisi"
                                           Foreground="{StaticResource TxtPrimary}"
                                           FontSize="22" FontWeight="Bold"/>
                                <TextBlock x:Name="lblDeviceManagerDesc"
                                           Text="İşaretlenen ses cihazları arka planda otomatik olarak gizlenir / devre dışı bırakılır."
                                           Foreground="{StaticResource TxtSecond}"
                                           FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="1" Background="{StaticResource BgCard}"
                                    CornerRadius="10" Padding="16"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                                <ScrollViewer>
                                    <ItemsControl x:Name="listAudioDevices">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BgInput}"
                                                        CornerRadius="8" Margin="0,0,0,8" Padding="14,10"
                                                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding FriendlyName}"
                                                                   Foreground="{StaticResource TxtPrimary}"
                                                                   FontSize="13" VerticalAlignment="Center"/>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsDisabled}"
                                                                  VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <StackPanel Grid.Row="2" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Margin="0,14,0,0">
                                <TextBlock x:Name="lblDeviceDelay" Text="Gecikme (sn):" Foreground="{StaticResource TxtSecond}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="txtDeviceDelay" Width="60"
                                         HorizontalContentAlignment="Center"
                                         LostFocus="TxtDeviceDelay_LostFocus" Margin="0,0,16,0"/>
                                <TextBlock x:Name="txtSavedDevice" Text="Kaydedildi ✔"
                                           Foreground="{StaticResource Accent}"
                                           VerticalAlignment="Center" Margin="0,0,14,0"
                                           Visibility="Collapsed"/>
                                <Button x:Name="btnSaveDevices" Style="{StaticResource AccentButton}"
                                        Padding="20,8" Content="Uygula ve Kaydet"
                                        Click="BtnSaveDevices_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- ════════════════════════════════════════════════ -->
                        <!-- 3) GPU MONITOR PAGE                             -->
                        <!-- ════════════════════════════════════════════════ -->
                        <Grid x:Name="pageGpuMonitor" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock x:Name="lblGpuMonitorHeader" Text="GPU Monitör &amp; Otomatik Profil"
                                           Foreground="{StaticResource TxtPrimary}"
                                           FontSize="22" FontWeight="Bold"/>
                                <TextBlock x:Name="lblGpuMonitorDesc" Text="NVIDIA GPU frekansını izler ve belirlenen limit aşıldığında Afterburner profilini tetikler."
                                           Foreground="{StaticResource TxtSecond}"
                                           FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Stat Cards -->
                            <Grid Grid.Row="1" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Core Clock Card -->
                                <Border Background="{StaticResource BgCard}" CornerRadius="10"
                                        Padding="18,14" Margin="0,0,8,0"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="lblGpuCoreClock" Text="ÇEKİRDEK HIZI"
                                                   Foreground="{StaticResource TxtSecond}"
                                                   FontSize="10" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock x:Name="txtGpuClock" Text="0"
                                                       Foreground="{StaticResource Accent}"
                                                       FontSize="32" FontWeight="Light"/>
                                            <TextBlock Text=" MHz" Foreground="{StaticResource TxtSecond}"
                                                       VerticalAlignment="Bottom" Margin="4,0,0,5"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Temperature Card -->
                                <Border Grid.Column="1" Background="{StaticResource BgCard}"
                                        CornerRadius="10" Padding="18,14" Margin="4,0,4,0"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="lblGpuTemperature" Text="SICAKLIK"
                                                   Foreground="{StaticResource TxtSecond}"
                                                   FontSize="10" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock x:Name="txtGpuTemp" Text="0"
                                                       Foreground="{StaticResource TxtPrimary}"
                                                       FontSize="32" FontWeight="Light"/>
                                            <TextBlock Text=" °C" Foreground="{StaticResource TxtSecond}"
                                                       VerticalAlignment="Bottom" Margin="4,0,0,5"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Usage Card -->
                                <Border Grid.Column="2" Background="{StaticResource BgCard}"
                                        CornerRadius="10" Padding="18,14" Margin="8,0,0,0"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="lblGpuUsage" Text="KULLANIM"
                                                   Foreground="{StaticResource TxtSecond}"
                                                   FontSize="10" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock x:Name="txtGpuUsage" Text="0"
                                                       Foreground="{StaticResource TxtPrimary}"
                                                       FontSize="32" FontWeight="Light"/>
                                            <TextBlock Text=" %" Foreground="{StaticResource TxtSecond}"
                                                       VerticalAlignment="Bottom" Margin="4,0,0,5"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Afterburner Config Card -->
                            <Border Grid.Row="2" Background="{StaticResource BgCard}"
                                    CornerRadius="10" Padding="20"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="lblGpuSettingsHeader" Text="MSI AFTERBURNER TETİKLEYİCİ"
                                               Foreground="{StaticResource TxtSecond}"
                                               FontSize="10" FontWeight="Bold" Margin="0,0,0,16"/>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="lblGpuLimitTitle" Text="Maksimum Saat Hızı Sınırı (MHz)"
                                                       Foreground="{StaticResource TxtPrimary}"/>
                                            <TextBlock x:Name="lblGpuLimitDesc" Text="Frekans bu sınırı aşarsa hedef profil otomatik uygulanır."
                                                       Foreground="{StaticResource TxtSecond}" FontSize="11"/>
                                        </StackPanel>
                                        <TextBox x:Name="txtTargetMhz" Grid.Column="1" Text="1550"
                                                 HorizontalContentAlignment="Center"
                                                 LostFocus="GpuSetting_Changed"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="lblGpuProfileTitle" Text="Uygulanacak Profil Numarası"
                                                       Foreground="{StaticResource TxtPrimary}"/>
                                            <TextBlock x:Name="lblGpuProfileDesc" Text="MSI Afterburner profil yuvası (1-5)"
                                                       Foreground="{StaticResource TxtSecond}" FontSize="11"/>
                                        </StackPanel>
                                        <ComboBox x:Name="cbTargetProfile" Grid.Column="1"
                                                  SelectionChanged="GpuSetting_Changed">
                                            <ComboBoxItem Content="Profil 1" Tag="1"/>
                                            <ComboBoxItem Content="Profil 2" Tag="2"/>
                                            <ComboBoxItem Content="Profil 3" Tag="3"/>
                                            <ComboBoxItem Content="Profil 4" Tag="4"/>
                                            <ComboBoxItem Content="Profil 5" Tag="5"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="lblGpuCooldownTitle" Text="Bekleme Süresi (Saniye)"
                                                       Foreground="{StaticResource TxtPrimary}"/>
                                            <TextBlock x:Name="lblGpuCooldownDesc" Text="Profil yeniden uygulanmadan önceki bekleme süresi."
                                                       Foreground="{StaticResource TxtSecond}" FontSize="11"/>
                                        </StackPanel>
                                        <ComboBox x:Name="cbCooldown" Grid.Column="1"
                                                  SelectionChanged="GpuSetting_Changed">
                                            <ComboBoxItem Content="15 Saniye" Tag="15"/>
                                            <ComboBoxItem Content="30 Saniye" Tag="30"/>
                                            <ComboBoxItem Content="60 Saniye" Tag="60"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ════════════════════════════════════════════════ -->
                        <!-- 4) SETTINGS PAGE                                -->
                        <!-- ════════════════════════════════════════════════ -->
                        <Grid x:Name="pageSettings" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock x:Name="lblSettingsHeader" Text="Ayarlar"
                                           Foreground="{StaticResource TxtPrimary}"
                                           FontSize="22" FontWeight="Bold"/>
                                <TextBlock x:Name="lblSettingsDesc" Text="Uygulama davranışını ve tercihlerini yapılandırın."
                                           Foreground="{StaticResource TxtSecond}"
                                           FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="1" Background="{StaticResource BgCard}"
                                    CornerRadius="10" Padding="20"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="lblGeneralSection" Text="GENEL AYARLAR"
                                               Foreground="{StaticResource TxtSecond}"
                                               FontSize="10" FontWeight="Bold" Margin="0,0,0,18"/>

                                                                        <!-- Start with Windows -->
                                    <Border Background="{StaticResource BgInput}" CornerRadius="8"
                                            Padding="14,12" Margin="0,0,0,10" BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="lblStartWithWin" Text="Windows ile Başlat"
                                                           Foreground="{StaticResource TxtPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="lblStartWithWinDesc"
                                                           Text="Bilgisayar açıldığında arka planda sessizce başlar."
                                                           Foreground="{StaticResource TxtSecond}" FontSize="11"/>
                                            </StackPanel>
                                            <CheckBox x:Name="chkStartup" Grid.Column="1"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                                                        <!-- Desktop ThrottleStop Widget -->
                                    <Border Background="{StaticResource BgInput}" CornerRadius="8"
                                            Padding="14,12" Margin="0,0,0,10" BorderThickness="0">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock x:Name="lblDesktopWidget" Text="Masaüstü ThrottleStop Widget'ı"
                                                               Foreground="{StaticResource TxtPrimary}" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="lblDesktopWidgetDesc"
                                                               Text="Masaüstüne sabit, hızlı profil kontrol widget'ı."
                                                               Foreground="{StaticResource TxtSecond}" FontSize="11"/>
                                                </StackPanel>
                                                <CheckBox x:Name="chkDesktopWidget" Grid.Column="1"
                                                          Checked="ChkDesktopWidget_Changed" Unchecked="ChkDesktopWidget_Changed"
                                                          VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Visible Profiles Selector -->
                                            <StackPanel x:Name="panelWidgetProfiles" Margin="0,10,0,0">
                                                <Separator Background="{StaticResource Border}" Margin="0,0,0,8"/>
                                                <TextBlock x:Name="lblWidgetProfilesTitle" Text="Widget'ta Görünecek Profiller:" Foreground="{StaticResource TxtSecond}" FontSize="11" Margin="0,0,0,6"/>
                                                <WrapPanel Orientation="Horizontal">
                                                    <CheckBox x:Name="chkWidgetProf1" Content="⚡ Performans" Margin="0,0,14,0" Checked="ChkWidgetProfile_Changed" Unchecked="ChkWidgetProfile_Changed"/>
                                                    <CheckBox x:Name="chkWidgetProf2" Content="🎮 Oyun" Margin="0,0,14,0" Checked="ChkWidgetProfile_Changed" Unchecked="ChkWidgetProfile_Changed"/>
                                                    <CheckBox x:Name="chkWidgetProf3" Content="🌐 İnternet" Margin="0,0,14,0" Checked="ChkWidgetProfile_Changed" Unchecked="ChkWidgetProfile_Changed"/>
                                                    <CheckBox x:Name="chkWidgetProf4" Content="🔋 Pil" Margin="0,0,0,0" Checked="ChkWidgetProfile_Changed" Unchecked="ChkWidgetProfile_Changed"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Language -->
                                    <Border Background="{StaticResource BgInput}" CornerRadius="8"
                                            Padding="14,12" Margin="0,0,0,10" BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="lblLanguage" Text="Dil / Language"
                                                       Foreground="{StaticResource TxtPrimary}"
                                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="cbLanguage" Grid.Column="1"
                                                      SelectionChanged="CbLanguage_SelectionChanged">
                                                <ComboBoxItem Content="Türkçe" Tag="TR"/>
                                                <ComboBoxItem Content="English" Tag="EN"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <!-- Scan Interval -->
                                    <Border Background="{StaticResource BgInput}" CornerRadius="8"
                                            Padding="14,12" BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="lblScanInterval" Text="Tarama Aralığı (ms)"
                                                           Foreground="{StaticResource TxtPrimary}" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="lblScanIntervalDesc"
                                                           Text="Aktif pencereyi kontrol etme frekansı"
                                                           Foreground="{StaticResource TxtSecond}" FontSize="11"/>
                                            </StackPanel>
                                            <TextBox x:Name="txtInterval" Grid.Column="1"
                                                     HorizontalContentAlignment="Center"
                                                     LostFocus="TxtInterval_LostFocus"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,14,0,0">
                                <Button x:Name="btnSaveSettings" Style="{StaticResource AccentButton}"
                                        Padding="22,9" Click="BtnSaveSettings_Click">
                                    <TextBlock x:Name="lblSaveBtn" Text="Ayarları Kaydet"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- ════════════════════════════════════════════════ -->
                        <!-- 5) TELEMETRY & HARDWARE MONITOR PAGE              -->
                        <!-- ════════════════════════════════════════════════ -->
                        <Grid x:Name="pageTelemetry" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,10,20">
                                    <!-- Page Header -->
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock x:Name="lblTelemetryHeader" Text="Sistem Telemetrisi"
                                                   Foreground="{StaticResource TxtPrimary}"
                                                   FontSize="22" FontWeight="Bold"/>
                                        <TextBlock x:Name="lblTelemetryDesc"
                                                   Text="Canlı sıcaklıklar, saat hızları, güç tüketimleri ve kullanım oranları."
                                                   Foreground="{StaticResource TxtSecond}"
                                                   FontSize="12" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- 1. ⭐ FAVORİLER (Pinned Quick Cards) -->
                                    <Border x:Name="pnlFavoritesContainer" Background="{StaticResource BgCard}"
                                            CornerRadius="10" Padding="16,14" Margin="0,0,0,14"
                                            BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="⭐" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="lblFavoritesTitle" Text="FAVORİLER / HIZLI BAKIŞ"
                                                           Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <WrapPanel x:Name="wpFavorites"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. 📈 CANLI GRAFİK (Son 60 Saniye) -->
                                    <Border Background="{StaticResource BgCard}"
                                            CornerRadius="10" Padding="16,14" Margin="0,0,0,14"
                                            BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                        <StackPanel>
                                            <!-- Graph Header / Legend -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="lblLiveGraphTitle" Text="CANLI SENSÖR GRAFİĞİ (SON 60 SANİYE)"
                                                           Foreground="{StaticResource TxtSecond}"
                                                           FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                
                                                <WrapPanel x:Name="wpGraphLegend" Grid.Column="1" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Hint if no graph items -->
                                            <TextBlock x:Name="txtNoGraphHint"
                                                       Text="Grafikte çizilmesini istediğiniz değerlerin yanındaki 📈 butonuna tıklayın."
                                                       Foreground="{StaticResource TxtMuted}" FontSize="11" Margin="0,0,0,8"
                                                       HorizontalAlignment="Center" Visibility="Collapsed"/>

                                            <!-- Graph Canvas Area -->
                                            <Border Background="#050B0C" CornerRadius="8" BorderBrush="{StaticResource Border}"
                                                    BorderThickness="1" Height="150" ClipToBounds="True">
                                                <Grid>
                                                    <Canvas x:Name="cvsChartGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                                    <Canvas x:Name="cvsChart" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                            SizeChanged="CvsChart_SizeChanged"/>
                                                </Grid>
                                            </Border>

                                            <!-- Time Axis Labels -->
                                            <Grid Margin="4,6,4,0">
                                                <TextBlock Text="-60s" Foreground="{StaticResource TxtMuted}" FontSize="9" HorizontalAlignment="Left"/>
                                                <TextBlock Text="-45s" Foreground="{StaticResource TxtMuted}" FontSize="9" HorizontalAlignment="Left" Margin="100,0,0,0"/>
                                                <TextBlock Text="-30s" Foreground="{StaticResource TxtMuted}" FontSize="9" HorizontalAlignment="Center"/>
                                                <TextBlock Text="-15s" Foreground="{StaticResource TxtMuted}" FontSize="9" HorizontalAlignment="Right" Margin="0,0,100,0"/>
                                                <TextBlock x:Name="lblGraphNow" Text="Şimdi" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. ALT KATEGORİLER (CPU, GPU, FANLAR, ANAKART, BELLEK) -->
                                    <StackPanel x:Name="pnlCategoriesContainer"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
